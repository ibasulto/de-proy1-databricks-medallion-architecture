# Copy to .env and fill. NEVER commit the real .env
# Used by local development and CI (GitHub Actions secrets mirror these).

# Databricks (used by databricks CLI / DAB / notebooks)
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<pat-token>

# Bundle variables (override DAB defaults)
DAB_CATALOG=retail_lakehouse
DAB_BRONZE_SCHEMA=bronze
DAB_SILVER_SCHEMA=silver
DAB_GOLD_SCHEMA=gold
DAB_VOLUME=retail_volumes
DAB_RAW_PATH=raw_landing
DAB_REPO_PATH=/Repos/<your-email>/de-proy1-databricks-medallion-architecture

# Synthetic data generator
DATA_SEED=42
DATA_STORES=60
DATA_PRODUCTS=800
DATA_START=2025-01-01
DATA_END=2026-12-31
DATA_INV_DAYS=56

# Supabase (optional, ver reporte: no es parte del core pipeline)
SUPABASE_URL=
SUPABASE_KEY=